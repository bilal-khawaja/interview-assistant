{
  "name": "vercelai",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "start": "bun run src/cli/ask-document.ts",
    "inspect": "bun run src/cli/inspect-asset.ts",
    "typecheck": "bun check",
    "server": "bun run scripts/server.ts",
    "producer": "bun run scripts/producer.ts",
    "consumer": "bun run scripts/consumer.ts",
    "chat": "bun run scripts/chat.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:check": "bun --bun drizzle-kit check"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.86",
    "@mastra/core": "1.76.0",
    "@mastra/loggers": "1.3.6",
    "@mastra/observability": "1.19.0",
    "@mastra/pg": "1.31.0",
    "@mastra/rag": "2.6.7",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "^7.0.130",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "pdfjs-dist": "6.4.299",
    "youtubei.js": "^18.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11"
  }
}
