# Application database
POSTGRES_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/interview_assistant

# Zitadel bootstrap credentials
POSTGRES_PASSWORD=change-me
ZITADEL_MASTERKEY=replace-with-a-32-character-master-key
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=change-me

# Local development email capture (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=no-reply@interview-assistant.local
